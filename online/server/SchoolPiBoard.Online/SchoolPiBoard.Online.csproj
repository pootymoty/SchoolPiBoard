<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SchoolPiBoard.Online</RootNamespace>
    <AssemblyName>SchoolPiBoard.Online</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <!-- Backplane SignalR: несколько инстансов должны видеть сообщения друг друга.
         Отсюда же берётся клиент Redis для списка присутствующих. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.8" />
    <!-- Отправка писем. SmtpClient из BCL объявлен устаревшим для нового кода. -->
    <PackageReference Include="MailKit" Version="4.7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sql/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
