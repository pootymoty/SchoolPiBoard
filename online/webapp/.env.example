# Адрес API онлайн-доски.
# В разработке — адрес запущенного сервера.
# В бою, если nginx проксирует API на том же домене (путь /api),
# укажите просто /api: тогда запросы идут на свой домен и CORS не нужен.
VITE_API_URL=http://localhost:5000

# Ключ сайта Yandex SmartCaptcha. Пусто — капча не показывается (только разработка).
VITE_CAPTCHA_SITEKEY=
