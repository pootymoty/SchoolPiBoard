<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SchoolPiBoard.LicenseServer</RootNamespace>
    <AssemblyName>SchoolPiBoard.LicenseServer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <!-- Отправка писем. SmtpClient из BCL объявлен устаревшим для нового кода. -->
    <PackageReference Include="MailKit" Version="4.7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Схема применяется при старте, поэтому файл должен лежать рядом с EXE. -->
    <None Update="sql/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
