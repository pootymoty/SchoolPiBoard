<Window x:Class="SchoolPiBoard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SchoolPiBoard.Views"
        Title="SchoolPiBoard"
        Icon="/schoolpiboard.ico"
        Height="880" Width="1340"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        SizeToContent="Manual"
        AllowsTransparency="False"
        Background="{DynamicResource AppBg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Используется стандартная рамка Windows/WPF.
         WindowStyle=None и WindowChrome намеренно не используются:
         это позволяет Windows 11 самостоятельно отрисовывать системные
         кнопки свернуть/развернуть/закрыть и корректно ограничивать
         максимизированное окно рабочей областью (без перекрытия панели задач). -->
    <Grid Background="{DynamicResource AppBg}">
        <views:HomeView x:Name="HomeScreen" Visibility="Visible"/>
        <views:EditorView x:Name="EditorScreen" Visibility="Collapsed"/>
    </Grid>
</Window>
