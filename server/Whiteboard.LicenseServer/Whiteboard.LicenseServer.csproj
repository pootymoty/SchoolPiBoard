<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Whiteboard.LicenseServer</RootNamespace>
    <AssemblyName>Whiteboard.LicenseServer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <!-- Backplane SignalR: несколько инстансов сервера должны видеть
         сообщения друг друга. Отсюда же берётся клиент Redis для присутствия. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Схема применяется при старте, поэтому файл должен лежать рядом с EXE. -->
    <None Update="sql/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
